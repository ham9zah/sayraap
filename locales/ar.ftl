core-ready = النواة جاهزة (الإصدار { $version }).
cli-usage =
    الاستخدام: sayraap [options] <command>
    الأوامر:
      ask "سؤال"          يرسل سؤالًا للنموذج ويطبع الجواب
      prompt <card.toml>  يطبع بطاقة المهمة كما يستلمها النموذج
      run <card.toml>     ينفذ بطاقة المهمة حتى تُقبل أو تتعثر
      tasks               يعرض مهام هذا المشروع المسجلة
      attempts <task>     يعرض كل محاولات مهمة (أضف --show-reply لعرض الردود الخام)
    الخيارات: --lang ar|en و --project-lang ar|en و --dir PATH و --max-lines N و --check "COMMAND" و --check-timeout SECONDS و --db FILE و --url URL و --model NAME و --timeout SECONDS
llm-unreachable = تعذر الوصول إلى النموذج على { $url }. تأكد أن الخادم يعمل.
llm-http-error = خادم النموذج رد بالخطأ { $status }.
llm-bad-response = خادم النموذج أرسل ردًا لا يمكن قراءته.
llm-tokens = [{ $model }] التوكنات: { $prompt } داخلة، { $completion } خارجة.

## بطاقة المهمة. أسطر العلامات (SEARCH و ======= و REPLACE و MISSING:) يقرؤها الكود: لا تُترجم أبدًا.
card-prompt =
    مهمتك تغيير واحد صغير في ملف واحد. التزم بهذه البطاقة حرفيًا.

    المطلوب
    { $goal }

    الملف (الوحيد المسموح بتعديله): { $file }
    بداية المحتوى الحالي
    { $current }
    نهاية المحتوى الحالي

    الممنوع
    { $forbidden }

    معايير القبول
    { $acceptance }

    صيغة الناتج
    أجب بكتلة تعديل واحدة أو أكثر ولا شيء غيرها. كل كتلة بهذا الشكل تمامًا، وكل سطر من أسطر العلامات الثلاثة يُستخدم مرة واحدة:
    <<<<<<< SEARCH
    أسطر منسوخة حرفيًا من المحتوى الحالي
    =======
    الأسطر التي تحل محلها
    >>>>>>> REPLACE

    القواعد
    1. جزء SEARCH يجب أن يطابق المحتوى الحالي حرفًا بحرف وأن يظهر فيه مرة واحدة فقط. اجعله قصيرًا.
    2. لإضافة نص جديد إلى ملف فيه محتوى: انسخ سطرًا موجودًا بجوار موضع الإضافة إلى SEARCH، ثم اكتب السطر نفسه مع النص الجديد في البديل. الإضافة ممكنة دائمًا بهذه الطريقة.
    3. إذا كان المحتوى الحالي أعلاه فارغًا فالملف جديد: اترك جزء SEARCH فارغًا واكتب الملف كله في البديل.
    4. لا تغيّر شيئًا لم تطلبه المهمة.

    فقط إذا احتاجت المهمة معلومة غير مكتوبة في هذه البطاقة (مثل اسم أو قيمة ستضطر لاختراعها) فلا تخمّن. أجب بهذا السطر الوحيد بدلًا من ذلك:
    MISSING: المعلومة التي تنقصك

card-prompt-new =
    مهمتك إنشاء ملف واحد جديد. التزم بهذه البطاقة حرفيًا.

    المطلوب
    { $goal }

    الملف المطلوب إنشاؤه: { $file }
    الملف غير موجود بعد. لا يوجد محتوى حالي، ولا تحتاج إليه.

    الممنوع
    { $forbidden }

    معايير القبول
    { $acceptance }

    صيغة الناتج
    أجب بالمحتوى الكامل للملف الجديد داخل كتلة كود واحدة (سطر فيه ثلاث علامات ``` قبله وسطر مثله بعده) ولا شيء غيرها.

    فقط إذا احتاجت المهمة معلومة غير مكتوبة في هذه البطاقة (مثل اسم أو قيمة ستضطر لاختراعها) فلا تخمّن. أجب بهذا السطر الوحيد بدلًا من ذلك:
    MISSING: المعلومة التي تنقصك

card-retry-note =
    محاولتك السابقة لهذه المهمة رُفضت لهذا السبب:
    { $reason }
    أصلح هذه المشكلة بالذات وأعطِ جوابًا مختلفًا بصيغة الناتج نفسها.

## التقسيم. الكلمات TASK و GOAL: و CHECK: يقرؤها الكود: لا تُترجم أبدًا.
split-prompt =
    جُرّبت مهمة صغيرة على ملف واحد ورُفضت. قسّمها إلى مهمتين أصغر بالضبط. ستُنفذان واحدة بعد الأخرى، ويجب أن تحققا معًا المهمة الأصلية.

    المهمة الأصلية
    { $goal }

    الملف: { $file }
    بداية المحتوى الحالي
    { $current }
    نهاية المحتوى الحالي

    سبب الرفض
    { $reason }

    صيغة الناتج
    أجب بهذه الأسطر الستة بالضبط ولا شيء غيرها:
    TASK 1
    GOAL: جملة أو جملتان تقولان ما تغيّره المهمة الأولى
    CHECK: عبارة واحدة تكون صحيحة عند اكتمال المهمة الأولى
    TASK 2
    GOAL: جملة أو جملتان تقولان ما تغيّره المهمة الثانية
    CHECK: عبارة واحدة تكون صحيحة عند اكتمال المهمة الثانية

split-unreadable = النموذج لم يُخرج مهمتين أصغر.
ladder-attempt = المهمة { $task }، المحاولة { $number }...
ladder-split = تقسيم المهمة { $task } إلى مهمتين أصغر...
ladder-split-done = قُسّمت إلى المهمتين { $first } و { $second }.
ladder-stuck = المهمة { $task } متعثرة وتنتظرك.
ladder-model-down = توقف العمل: تعذر الوصول إلى خادم النموذج. المهمة ما زالت بانتظار التنفيذ.
run-accepted = تم: المهمة { $task } مقبولة.
run-stuck = المهمة { $task } لم تكتمل. اعرض محاولاتها بالأمر: sayraap attempts { $task }
llm-timeout = النموذج لم يُجب خلال { $seconds } ثانية.
detector-repeat-output = كُشف: الرد نفسه كمحاولة سابقة.
detector-repeat-error = كُشف: رُفضت للسبب نفسه كالمحاولة التي قبلها.
detector-no-change = كُشف: النموذج أجاب لكن لا شيء سيتغير.
detector-out-of-scope = كُشف: خارج الملف المسموح أو الحجم المسموح.
detector-timeout = كُشف: انتهت المهلة.
attempt-line-split = المحاولة { $number } [{ $model }] تقسيم: { $outcome } — التوكنات { $prompt } داخلة، { $completion } خارجة، { $seconds } ث

card-unreadable = تعذرت قراءة بطاقة المهمة: { $detail }
card-no-goal = بطاقة المهمة بلا مطلوب.
card-no-acceptance = بطاقة المهمة بلا معايير قبول.
card-bad-path = بطاقة المهمة تسمّي ملفًا خارج المشروع: "{ $file }".
file-unreadable = تعذرت قراءة { $path }.
file-unwritable = تعذرت الكتابة في { $path }.
edit-unreadable = رد النموذج لم يلتزم بصيغة الناتج.
edit-not-found = التعديل { $index }: النص المطلوب إيجاده غير موجود في الملف.
edit-ambiguous = التعديل { $index }: النص المطلوب إيجاده يظهر أكثر من مرة.
edit-no-change = تعديلات النموذج تترك الملف كما هو.
task-missing-info = النموذج توقف وطلب: { $detail }
task-accepted = قُبلت: تغيّر في { $file } { $lines ->
        [one] سطر واحد
        [two] سطران
        [few] { $lines } أسطر
       *[other] { $lines } سطرًا
    }، وحُفظت كخطوة { $commit }.
task-rejected = رُفضت. المشروع كما كان تمامًا.
task-too-large = التغيير يمس { $changed ->
        [one] سطرًا واحدًا
        [two] سطرين
        [few] { $changed } أسطر
       *[other] { $changed } سطرًا
    }، والحد { $limit }.
task-out-of-scope = تغيّرت ملفات خارج المهمة: { $files }
repo-not-found = { $path } ليس مشروعًا له خطوات محفوظة (لا يوجد مستودع Git في جذره).
repo-no-commit = المشروع بلا أي خطوة محفوظة بعد، فلا يوجد ما يُرجع إليه.
repo-dirty = في المشروع تغييرات غير محفوظة ({ $files }). احفظها أو تخلص منها أولًا؛ المهمة لم تبدأ.
repo-failed = سجل الخطوات أبلغ عن خطأ: { $detail }
task-check-failed =
    أمر الفحص وجد مشكلة في التغيير:
    { $detail }
task-check-timeout = أمر الفحص لم ينتهِ خلال { $seconds } ثانية.
check-unavailable = تعذر تشغيل أمر الفحص: { $command }. لم يُحكم على المهمة ولم يتغير شيء.

task-line = { $id }  [{ $status }]  { $file }  المحاولات: { $attempts }  الخطوة: { $commit }  مقسّمة من: { $parent }  { $goal }
tasks-empty = لا مهام مسجلة لهذا المشروع بعد.
task-not-found = لا توجد في هذا المشروع مهمة "{ $id }".
attempt-line = المحاولة { $number } [{ $model }] { $outcome } — التوكنات { $prompt } داخلة، { $completion } خارجة، { $seconds } ث
status-pending = بانتظار التنفيذ
status-running = قيد التنفيذ
status-checking = قيد الفحص
status-accepted = مقبولة
status-rejected = مرفوضة
status-stuck = متعثرة
status-cancelled = ملغاة
outcome-running = لم تكتمل
outcome-accepted = مقبولة
outcome-rejected = مرفوضة
outcome-error = تعذر الحكم عليها
store-failed = قاعدة بيانات المهام أبلغت عن خطأ: { $detail }
store-no-folder = لم يُعثر على مجلد بيانات التطبيقات لقاعدة بيانات المهام. حدد ملفًا بـ --db FILE.
